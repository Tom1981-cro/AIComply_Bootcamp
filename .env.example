# =============================================================================
# EU AI Act SME Compliance Pack — environment variables
# Copy to `.env` and fill in. NEVER commit real secrets.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Public base URL of the storefront (no trailing slash).
NEXT_PUBLIC_APP_URL="https://hub.ai-comply.ie"

# --- Database (PostgreSQL via Prisma) ----------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/aicomply_bootcamp?schema=public"

# --- Lemon Squeezy (Merchant of Record) --------------------------------------
# Your store's hosted-checkout base, e.g. https://yourstore.lemonsqueezy.com
LEMON_STORE_URL=""
# Webhook signing secret (Settings → Webhooks). Required; webhooks are rejected without it.
LEMON_WEBHOOK_SECRET=""
# Variant IDs for each tier (Products → Variant → "Copy variant ID").
LEMON_VARIANT_STARTER=""
LEMON_VARIANT_PRO=""
LEMON_VARIANT_CONSULTANT=""

# --- Resend (transactional email + audience) ---------------------------------
RESEND_API_KEY=""
# Verified sender. Defaults to "AIComply Toolkit <toolkit@aicomply.com>".
RESEND_FROM="AIComply Toolkit <toolkit@aicomply.com>"
# Audience id for "ai-act-sme". Optional — audience add is skipped if unset.
RESEND_AUDIENCE_ID=""

# --- Object storage for protected downloads ----------------------------------
# Hetzner Object Storage (S3-compatible) by default. Works with any S3-
# compatible backend (R2, AWS S3, MinIO) — just change S3_ENDPOINT/S3_REGION.
# Hetzner endpoints by location:
#   Falkenstein  → https://fsn1.your-objectstorage.com   region: fsn1
#   Nuremberg    → https://nbg1.your-objectstorage.com   region: nbg1
#   Helsinki     → https://hel1.your-objectstorage.com   region: hel1
S3_ENDPOINT="https://fsn1.your-objectstorage.com"
S3_REGION="fsn1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# --- Fulfillment extras ------------------------------------------------------
# Loom walkthrough URL included with Pro and Consultant tiers.
LOOM_WALKTHROUGH_URL=""

# --- Admin dashboard (HTTP basic auth) ---------------------------------------
# /admin is locked out entirely until ADMIN_PASSWORD is set.
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# --- PostHog analytics (optional; no-ops when unset) -------------------------
# Server-side capture:
POSTHOG_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"
# Client-side capture (must be NEXT_PUBLIC_ to reach the browser):
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
